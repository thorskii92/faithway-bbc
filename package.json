{
  "name": "faithway-bbc",
  "version": "0.1.0",
  "private": true,
  "description": "Palawan Faithway Bible Baptist Church website",
  "type": "module",
  "scripts": {
    "start": "serve docs -l 4173",
    "preview": "serve prototype -l 4174",
    "map": "node scripts/gen.mjs prototype/map.js",
    "data": "node scripts/data.mjs MISSION/missionaries.csv prototype/missionaries.js",
    "photos": "uv run --with pillow python -I scripts/crop.py MISSION/cards prototype",
    "build": "node scripts/build-docs.mjs prototype docs"
  },
  "devDependencies": {
    "d3-geo": "3.1.1",
    "serve": "14.2.4",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  }
}
